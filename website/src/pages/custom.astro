---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RugVisual from '../components/RugVisual.astro';
---
<BaseLayout title="Индивидуальный заказ — VORS STUDIO" description="Создание ковра VORS по готовому дизайну или вашей идее.">
  <Header />
  <main class="custom-page">
    <section class="custom-hero shell">
      <div class="copy">
        <span class="eyebrow">VORS CUSTOM</span>
        <h1>Ваш замысел.<br />Наше ремесло.</h1>
        <p>Можно выбрать дизайн из VORS Collection и адаптировать его под себя — или прийти с рисунком, фотографией, логотипом, цветами и даже просто идеей.</p>
        <a class="button button-dark" href="#brief">Обсудить ковёр</a>
      </div>
      <div class="visual"><RugVisual variant="sand" label="Индивидуальный ковёр VORS" /></div>
    </section>

    <section class="shell route-grid" aria-label="Варианты заказа">
      <article><span>01</span><h2>Дизайн VORS</h2><p>Берём модель из коллекции и согласуем размер, палитру и детали перед изготовлением.</p><a href="/catalog/">Выбрать дизайн →</a></article>
      <article><span>02</span><h2>Своя идея</h2><p>Вы присылаете референс или описываете задачу. Мы подготавливаем макет и только после согласования запускаем работу.</p><a href="#brief">Рассказать идею →</a></article>
    </section>

    <section class="shell brief" id="brief">
      <div>
        <span class="eyebrow">ЗАЯВКА</span>
        <h2>С чего начнём</h2>
        <p>Сначала фиксируем идею, примерный размер и способ связи. Потом обсуждаем макет, стоимость и срок — без автоматического запуска в производство.</p>
      </div>
      <form onsubmit="return false">
        <label>Дизайн из коллекции, если выбрали<input data-design-input name="design" placeholder="Например SAGE LAND" /></label>
        <label>Что хотите сделать?<textarea placeholder="Например: спокойный ковёр 80 × 120 см в бежево-оливковой палитре. Референс пришлю отдельно"></textarea></label>
        <div class="two"><label>Примерный размер<input placeholder="Например 80 × 120 см" /></label><label>Ориентир по бюджету<input placeholder="Например до 20 000 ₽" /></label></div>
        <label>Как с вами связаться?<input placeholder="Telegram / MAX / телефон" /></label>
        <button class="button button-dark" type="button" disabled>Отправить заявку</button>
        <small>В этой preview-версии форма пока ничего не отправляет. Перед запуском подключим заявки к рабочей системе VORS.</small>
      </form>
    </section>

    <section class="steps shell">
      <article><span>01</span><h3>Заявка</h3><p>Вы выбираете дизайн или описываете свою идею.</p></article>
      <article><span>02</span><h3>Согласование</h3><p>Фиксируем макет, размер, палитру, стоимость и срок.</p></article>
      <article><span>03</span><h3>Производство</h3><p>Только после согласования создаём ваш экземпляр и открываем страницу заказа.</p></article>
    </section>
  </main>
  <Footer />

  <script>
    const params = new URLSearchParams(window.location.search);
    const design = params.get('design');
    const input = document.querySelector('[data-design-input]');
    if (design && input instanceof HTMLInputElement) {
      input.value = design.replaceAll('-', ' ').toUpperCase();
    }
  </script>
</BaseLayout>
<style>
.custom-page{padding-top:6rem}.custom-hero{min-height:78vh;display:grid;grid-template-columns:1.05fr .95fr;gap:4rem;align-items:center;padding-top:4rem;padding-bottom:6rem}.custom-hero h1{font-size:clamp(3rem,5.4vw,5.2rem);line-height:.97;letter-spacing:-.055em;margin:.5rem 0 1.5rem}.custom-hero p{max-width:620px;font-size:1.12rem;line-height:1.7;color:var(--muted);margin-bottom:2rem}.visual{min-height:520px;display:flex;align-items:center;justify-content:center;background:#e8e0d2;border-radius:1.5rem;padding:3rem}.route-grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(31,29,25,.12);margin-bottom:7rem}.route-grid article{background:#f3efe7;padding:2rem}.route-grid span{font-size:.76rem}.route-grid h2{font-size:1.6rem;margin:2.5rem 0 .7rem}.route-grid p{color:var(--muted);line-height:1.65;max-width:540px}.route-grid a{color:inherit;text-decoration:none;font-weight:650}.brief{display:grid;grid-template-columns:.8fr 1.2fr;gap:5rem;padding-top:7rem;padding-bottom:7rem;border-top:1px solid rgba(31,29,25,.12)}.brief h2{font-size:clamp(2.15rem,3.6vw,3.5rem);margin:.5rem 0 1rem;letter-spacing:-.045em}.brief p{color:var(--muted);line-height:1.7}.brief form{display:grid;gap:1.25rem}.brief label{display:grid;gap:.55rem;font-size:.92rem}.brief input,.brief textarea{width:100%;box-sizing:border-box;border:1px solid rgba(31,29,25,.18);background:#fffdf8;border-radius:1rem;padding:1rem;font:inherit}.brief textarea{min-height:160px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.brief small{color:var(--muted)}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(31,29,25,.12);margin-bottom:7rem}.steps article{background:#f3efe7;padding:2.2rem}.steps span{font-size:.78rem}.steps h3{font-size:1.4rem;margin:2.5rem 0 .6rem}.steps p{color:var(--muted);line-height:1.6}.button[disabled]{opacity:.5;cursor:not-allowed}
@media(max-width:760px){.custom-page{padding-top:3.2rem}.custom-hero{grid-template-columns:1fr;min-height:auto;gap:1.8rem;padding-top:2.8rem;padding-bottom:3.5rem}.custom-hero h1{font-size:clamp(2.3rem,10vw,2.85rem);line-height:1}.custom-hero p{font-size:1rem;line-height:1.62}.visual{min-height:300px;border-radius:1.25rem}.route-grid{grid-template-columns:1fr;margin-bottom:3.5rem}.brief{grid-template-columns:1fr;gap:1.6rem;padding-top:3.5rem;padding-bottom:3.5rem}.brief h2{font-size:2rem}.two{grid-template-columns:1fr}.steps{grid-template-columns:1fr;margin-bottom:3.5rem}}
</style>
