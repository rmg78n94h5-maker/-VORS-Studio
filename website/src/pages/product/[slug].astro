---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import RugVisual from '../../components/RugVisual.astro';
import { collectionDesigns } from '../../data/collection';

export function getStaticPaths() {
  return collectionDesigns.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
---
<BaseLayout title={`${product.name} — VORS STUDIO`} description={`${product.name}, дизайн ковра VORS Studio под заказ.`}>
<Header />
<main class="product-page shell">
  <a class="back" href="/catalog/">← VORS Collection</a>
  <section class="product-layout">
    <div class="visual"><RugVisual variant={product.variant} label={`${product.name}, дизайн ковра VORS`} /></div>
    <div class="copy">
      <span class="eyebrow">VORS COLLECTION</span>
      <h1>{product.name}</h1>
      <p class="status">Изготовим под заказ</p>
      <p class="lead">{product.text}</p>
      <div class="made-note"><strong>Этот ковёр не ждёт покупателя на складе.</strong><span>После заказа мы согласуем параметры и изготовим ваш экземпляр.</span></div>
      <dl>
        <div><dt>Базовый размер</dt><dd>{product.size}</dd></div>
        <div><dt>Размер и палитра</dt><dd>Можно обсудить</dd></div>
        <div><dt>Производство</dt><dd>Ручная работа под заказ</dd></div>
        <div><dt>Фактура</dt><dd>Короткий плотный тафтинговый ворс</dd></div>
      </dl>
      <div class="buy"><strong>{product.price}</strong><a class="button button-dark" href={`/custom/?design=${product.slug}#brief`}>Заказать этот дизайн</a></div>
      <small>Цена пока ориентировочная для превью. До запуска производства фиксируем размер, палитру, стоимость и срок.</small>
    </div>
  </section>
</main>
<Footer />
</BaseLayout>
<style>
.product-page{padding-top:9rem;padding-bottom:8rem}.back{text-decoration:none;color:var(--muted);font-size:.9rem}.product-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:5rem;align-items:center;margin-top:2rem}.visual{min-height:620px;background:#e8e0d2;border-radius:1.5rem;padding:4rem;display:flex;align-items:center;justify-content:center}.copy h1{font-size:clamp(3rem,5.2vw,5.2rem);line-height:.96;letter-spacing:-.06em;margin:.6rem 0}.status{display:inline-block;background:#ded5c6;border-radius:999px;padding:.45rem .75rem;font-size:.8rem}.lead{font-size:1.1rem;line-height:1.7;color:var(--muted);margin:1.8rem 0}.made-note{padding:1.2rem 0 1.4rem;border-top:1px solid rgba(31,29,25,.14);display:grid;gap:.35rem}.made-note strong{font-size:.95rem}.made-note span{color:var(--muted);font-size:.9rem;line-height:1.55}.copy dl{margin:0;border-top:1px solid rgba(31,29,25,.14)}.copy dl div{display:flex;justify-content:space-between;gap:1rem;padding:1rem 0;border-bottom:1px solid rgba(31,29,25,.14)}dt{color:var(--muted)}dd{margin:0;text-align:right}.buy{display:flex;align-items:center;justify-content:space-between;gap:1rem;margin:2rem 0}.buy strong{font-size:1.55rem}.copy small{display:block;color:var(--muted);line-height:1.5}
@media(max-width:760px){.product-page{padding-top:7rem;padding-bottom:5rem}.product-layout{grid-template-columns:1fr;gap:2rem}.visual{min-height:360px;padding:2rem}.buy{align-items:stretch;flex-direction:column}.buy .button{text-align:center}.copy dl div{align-items:flex-start}.copy dl dd{max-width:55%}}
</style>
