---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RugVisual from '../components/RugVisual.astro';

const products = [
  { name: 'FORM 01', size: '80 × 120 см', price: '18 900 ₽', variant: 'sage', status: 'В наличии' },
  { name: 'FORM 02', size: 'Ø 90 см', price: '14 900 ₽', variant: 'clay', status: 'На заказ' },
  { name: 'LINE 01', size: '90 × 140 см', price: '21 900 ₽', variant: 'graphite', status: 'На заказ' },
  { name: 'FORM 03', size: '70 × 110 см', price: '16 900 ₽', variant: 'sand', status: 'В наличии' }
] as const;

const process = [
  ['01', 'Идея', 'Расскажите, какой ковёр хотите получить, или отправьте изображение.'],
  ['02', 'Макет', 'Согласуем форму, размер, цвета и стоимость до начала работы.'],
  ['03', 'Материалы', 'Подберём оттенки и фактуру под будущий ковёр.'],
  ['04', 'Тафтинг', 'Переносим рисунок на основу и создаём ковёр вручную.'],
  ['05', 'Финиш', 'Стрижём, выравниваем и тщательно прорабатываем контуры.'],
  ['06', 'Доставка', 'Проверяем, упаковываем и отправляем готовый VORS.']
] as const;
---
<BaseLayout>
  <div id="top"></div>
  <Header />

  <main>
    <section class="hero section-space">
      <div class="shell hero-grid">
        <div class="hero-copy reveal">
          <span class="eyebrow">КОВРЫ РУЧНОЙ РАБОТЫ · VORS STUDIO</span>
          <h1>Больше, чем ковёр.<br /><em>Часть вашего пространства.</em></h1>
          <p class="hero-lead">Ковры ручной работы для дома, бизнеса и особенных идей. Готовые дизайны и индивидуальные проекты — от первого эскиза до финальной стрижки.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#catalog">Смотреть ковры</a>
            <a class="button button-ghost" href="#custom">Создать свой</a>
          </div>
          <div class="hero-meta">
            <span>Ручная работа</span>
            <span>Индивидуальный дизайн</span>
            <span>Доставка по России</span>
          </div>
        </div>

        <div class="hero-art" aria-label="Концептуальный интерьер с ковром VORS">
          <div class="room-panel">
            <div class="room-light"></div>
            <div class="wall-art art-one"></div>
            <div class="wall-art art-two"></div>
            <div class="sofa"><span></span><span></span></div>
            <div class="side-table"><span></span></div>
            <div class="floor-rug"><div class="floor-rug-shape"></div></div>
            <div class="hero-stamp">VORS<br /><small>STUDIO</small></div>
          </div>
        </div>
      </div>
    </section>

    <section class="intro section-space-tight">
      <div class="shell intro-grid">
        <div>
          <span class="eyebrow">О VORS</span>
          <h2>Сделано руками.<br />Сделано для вашего пространства.</h2>
        </div>
        <div class="intro-copy">
          <p>Мы не печатаем рисунок на готовом ковре. Каждый VORS создаётся с нуля: выбираем форму, оттенки и фактуру, переносим рисунок на основу, тафтим, стрижём и доводим вручную.</p>
          <p>Поэтому даже два ковра по одному дизайну сохраняют характер ручной работы.</p>
        </div>
      </div>

      <div class="shell feature-grid">
        <article><span>01</span><h3>Ручная работа</h3><p>От основы до финальной обработки.</p></article>
        <article><span>02</span><h3>Индивидуально</h3><p>Размер, форма, цвета и рисунок под вашу идею.</p></article>
        <article><span>03</span><h3>В деталях</h3><p>Продумываем не только изображение, но и фактуру.</p></article>
        <article><span>04</span><h3>С доставкой</h3><p>Надёжно упаковываем и отправляем по России.</p></article>
      </div>
    </section>

    <section class="paths section-space">
      <div class="shell section-heading">
        <span class="eyebrow">НАПРАВЛЕНИЯ</span>
        <h2>Выберите свой VORS</h2>
      </div>

      <div class="shell path-grid">
        <article class="path-card path-ready">
          <div class="path-art"><RugVisual variant="sage" compact /></div>
          <div class="path-content"><span>01</span><h3>Готовые ковры</h3><p>Дизайны VORS, которые уже готовы или могут быть изготовлены повторно.</p><a href="#catalog">Смотреть коллекцию →</a></div>
        </article>
        <article class="path-card path-custom" id="custom">
          <div class="path-art"><RugVisual variant="clay" compact /></div>
          <div class="path-content"><span>02</span><h3>Индивидуальный заказ</h3><p>Пришлите рисунок, логотип, фотографию или просто идею. Поможем превратить её в ковёр.</p><a href="#custom-form">Создать свой ковёр →</a></div>
        </article>
        <article class="path-card path-business">
          <div class="path-art"><RugVisual variant="graphite" compact /></div>
          <div class="path-content"><span>03</span><h3>VORS для бизнеса</h3><p>Фирменные ковры для салонов, кафе, магазинов, студий и офисов.</p><a href="#business">Для бизнеса →</a></div>
        </article>
      </div>
    </section>

    <section class="catalog section-space" id="catalog">
      <div class="shell section-heading heading-row">
        <div><span class="eyebrow">КОЛЛЕКЦИЯ</span><h2>Выбрано в VORS</h2></div>
        <a class="text-link" href="#catalog">Вся коллекция →</a>
      </div>
      <div class="shell product-grid">
        {products.map((product) => (
          <article class="product-card">
            <div class="product-art">
              <span class="product-status">{product.status}</span>
              <RugVisual variant={product.variant} label={`${product.name}, ковёр VORS`} />
            </div>
            <div class="product-info">
              <div><h3>{product.name}</h3><span>{product.size}</span></div>
              <strong>{product.price}</strong>
            </div>
          </article>
        ))}
      </div>
      <p class="shell prototype-note">Товары и цены в этой версии — демонстрационные. Перед запуском заменим их реальным ассортиментом.</p>
    </section>

    <section class="custom-section section-space" id="custom-form">
      <div class="shell custom-grid">
        <div class="custom-art">
          <div class="sketch-card"><span>ВАША ИДЕЯ</span><div class="sketch-lines"></div></div>
          <div class="arrow-mark">→</div>
          <RugVisual variant="sand" label="Пример индивидуального ковра VORS" />
        </div>
        <div class="custom-copy">
          <span class="eyebrow">ИНДИВИДУАЛЬНЫЙ ЗАКАЗ</span>
          <h2>У вас есть идея.<br />У нас — способ превратить её в ковёр.</h2>
          <p>Не обязательно приходить с готовым макетом. Это может быть рисунок, фотография, логотип, узор, сочетание цветов или просто мысль, которую пока сложно представить в готовом виде.</p>
          <p>Поможем подобрать форму, размер, цвета и материалы и подготовим проект до начала работы.</p>
          <button class="button button-dark" type="button" disabled>Создать свой VORS</button>
          <small>Форма заявки появится после подключения базы. Заявка ни к чему не будет обязывать.</small>
        </div>
      </div>
    </section>

    <section class="process section-space" id="process">
      <div class="shell process-head">
        <div><span class="eyebrow">ПРОЦЕСС</span><h2>От идеи до готового VORS</h2></div>
        <p>Показываем путь заказа без тумана, «менеджер уточнит» и исчезновения мастерской на две недели.</p>
      </div>
      <div class="shell process-grid">
        {process.map(([num, title, text]) => (
          <article><span>{num}</span><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </section>

    <section class="tracking section-space" id="tracking">
      <div class="shell tracking-grid">
        <div class="tracking-copy">
          <span class="eyebrow eyebrow-light">ОТСЛЕЖИВАНИЕ</span>
          <h2>Ваш заказ не исчезает в мастерской.</h2>
          <p>После оформления у заказа появится собственная страница. На ней — этап работы, фотографии процесса и информация об отправке.</p>
          <div class="messenger-row"><span>Telegram</span><span>MAX</span><span>Сайт</span></div>
        </div>
        <div class="order-card">
          <div class="order-card-head"><div><small>ЗАКАЗ</small><strong>VORS №0024</strong></div><span>В РАБОТЕ</span></div>
          <div class="order-progress">
            <div class="done"><i>✓</i><span><strong>Макет согласован</strong><small>Готово</small></span></div>
            <div class="done"><i>✓</i><span><strong>Материалы подготовлены</strong><small>Готово</small></span></div>
            <div class="active"><i></i><span><strong>Тафтинг</strong><small>Сейчас</small></span></div>
            <div><i></i><span><strong>Финиш</strong><small>Следующий этап</small></span></div>
            <div><i></i><span><strong>Упаковка и отправка</strong><small>Позже</small></span></div>
          </div>
        </div>
      </div>
    </section>

    <section class="materials section-space" id="materials">
      <div class="shell materials-grid">
        <div class="texture-board" aria-label="Стилизованный крупный план аккуратного тафтингового ворса">
          <div class="fiber f1"></div><div class="fiber f2"></div><div class="fiber f3"></div><div class="fiber f4"></div>
          <span>ФАКТУРА · VORS</span>
        </div>
        <div class="materials-copy">
          <span class="eyebrow">МАТЕРИАЛЫ И ФАКТУРА</span>
          <h2>Ковёр должен хорошо выглядеть не только на фотографии.</h2>
          <p>Высота и плотность ворса, сочетание оттенков, рельеф, обработка краёв и обратная сторона влияют на то, как готовый ковёр выглядит и ощущается в пространстве.</p>
          <a class="text-link" href="#materials">О материалах →</a>
        </div>
      </div>
    </section>

    <section class="business section-space" id="business">
      <div class="shell business-grid">
        <div>
          <span class="eyebrow eyebrow-light">VORS ДЛЯ БИЗНЕСА</span>
          <h2>Фирменный ковёр может работать на пространство не хуже вывески.</h2>
        </div>
        <div class="business-copy">
          <p>Создаём ковры с логотипами, графикой и индивидуальными формами для кафе, салонов, магазинов, офисов, шоурумов и мероприятий.</p>
          <div class="business-tags"><span>Логотипы</span><span>Фирменная графика</span><span>Нестандартные формы</span><span>Небольшие серии</span></div>
          <a class="button button-light" href="#custom-form">Обсудить проект</a>
        </div>
      </div>
    </section>

    <section class="craft section-space">
      <div class="shell craft-grid">
        <div class="craft-scene">
          <div class="frame-bars"></div>
          <div class="tuft-panel"><div class="tuft-pattern"></div></div>
          <div class="tool-silhouette"></div>
        </div>
        <div class="craft-copy">
          <span class="eyebrow">РУЧНАЯ РАБОТА</span>
          <h2>Каждый VORS проходит через руки мастера.</h2>
          <p>Тафтинг — только часть процесса. После него ковёр предстоит проклеить, обработать, выстричь, сформировать контуры, проверить и подготовить к отправке.</p>
          <p class="muted">Позже этот блок заменим реальными фото и видео из мастерской — без чужих каталогов и фотостоков.</p>
        </div>
      </div>
    </section>

    <section class="delivery section-space-tight" id="delivery">
      <div class="shell section-heading"><span class="eyebrow">ОПЛАТА И ДОСТАВКА</span><h2>Просто и понятно</h2></div>
      <div class="shell delivery-grid">
        <article><span>01</span><h3>Оплата</h3><p>Онлайн картой или через СБП. После оплаты — электронный чек.</p></article>
        <article><span>02</span><h3>Доставка</h3><p>Отправляем по России. Стоимость и срок будут известны до отправки.</p></article>
        <article><span>03</span><h3>Индивидуальный заказ</h3><p>До начала изготовления согласуем макет, стоимость и условия оплаты.</p></article>
      </div>
    </section>

    <section class="final-cta section-space">
      <div class="shell final-card">
        <span class="eyebrow">ВАШ VORS</span>
        <h2>Какой VORS будет вашим?</h2>
        <p>Выберите готовый дизайн или расскажите нам о своей идее.</p>
        <div><a class="button button-dark" href="#custom-form">Создать свой ковёр</a><a class="button button-ghost" href="#catalog">Смотреть коллекцию</a></div>
      </div>
    </section>
  </main>

  <Footer />

  <a class="mobile-sticky-cta" href="#custom-form">Создать свой VORS</a>
</BaseLayout>
