---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RugVisual from '../components/RugVisual.astro';
import { collectionDesigns } from '../data/collection';
---
<BaseLayout title="VORS Collection — VORS STUDIO" description="Дизайны VORS Studio, которые изготавливаются под заказ.">
  <Header />
  <main class="catalog-page">
    <section class="page-hero shell">
      <span class="eyebrow">VORS COLLECTION</span>
      <h1>Выберите дизайн.<br />Мы сделаем ваш экземпляр.</h1>
      <p>Большинство ковров VORS не лежат на складе. Вы выбираете модель, размер и палитру — после согласования мы запускаем конкретный ковёр в производство.</p>
    </section>

    <section class="shell model-note" aria-label="Как работает коллекция">
      <div><span>01</span><strong>Выберите дизайн</strong><small>Форма и характер уже продуманы.</small></div>
      <div><span>02</span><strong>Настройте под себя</strong><small>Размер и палитру можно обсудить до старта.</small></div>
      <div><span>03</span><strong>Запускаем в работу</strong><small>Ковёр создаётся специально под ваш заказ.</small></div>
    </section>

    <section class="shell product-grid catalog-grid">
      {collectionDesigns.map((product) => (
        <a class="product-card catalog-link" href={`/product/${product.slug}/`}>
          <div class="product-art">
            <span class="product-status">Под заказ</span>
            <RugVisual variant={product.variant} label={`${product.name}, дизайн ковра VORS`} />
          </div>
          <div class="product-info">
            <div><h2>{product.name}</h2><span>{product.size} · {product.category}</span></div>
            <strong>{product.price}</strong>
          </div>
        </a>
      ))}
    </section>

    <section class="shell ready-block" id="ready">
      <div>
        <span class="eyebrow">VORS READY</span>
        <h2>Готовые экземпляры появляются редко.</h2>
      </div>
      <p>Иногда у нас есть съёмочные образцы или единичные ковры, которые можно забрать без ожидания производства. Когда такие работы появятся, они будут отмечены здесь отдельно. Сейчас свободных готовых экземпляров нет.</p>
    </section>

    <p class="shell prototype-note">Цены в превью пока ориентировочные. Перед запуском заменим визуализации реальными фотографиями и закрепим финальные размеры, сроки и стоимость.</p>
  </main>
  <Footer />
</BaseLayout>

<style>
  .catalog-page{padding-top:6rem}.page-hero{padding-top:5rem;padding-bottom:3rem;max-width:1180px}.page-hero h1{font-size:clamp(2.9rem,5.6vw,5.25rem);margin:.25rem 0 1rem;letter-spacing:-.055em;line-height:.94}.page-hero p{max-width:760px;font-size:1.08rem;line-height:1.7;color:var(--muted)}
  .model-note{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:rgba(31,29,25,.12);margin-bottom:3rem}.model-note>div{background:#f3efe7;padding:1.5rem}.model-note span{font-size:.72rem}.model-note strong{display:block;margin:2rem 0 .45rem}.model-note small{display:block;color:var(--muted);line-height:1.5}.catalog-grid{padding-bottom:5rem}.catalog-link{text-decoration:none;color:inherit}.catalog-link h2{font:inherit;font-size:1rem;margin:0 0 .3rem}.ready-block{display:grid;grid-template-columns:.9fr 1.1fr;gap:5rem;padding-top:5rem;padding-bottom:5rem;border-top:1px solid rgba(31,29,25,.14);border-bottom:1px solid rgba(31,29,25,.14)}.ready-block h2{font-size:clamp(2.15rem,3.6vw,3.45rem);letter-spacing:-.045em;margin:.4rem 0}.ready-block p{color:var(--muted);font-size:1.05rem;line-height:1.75;margin:0}.prototype-note{padding-top:2rem;padding-bottom:7rem}
  @media(max-width:760px){.catalog-page{padding-top:4rem}.page-hero{padding-top:3.5rem}.model-note{grid-template-columns:1fr}.catalog-grid{grid-template-columns:1fr 1fr;gap:1rem}.product-info{align-items:flex-start;gap:.3rem;flex-direction:column}.product-info strong{font-size:.95rem}.ready-block{grid-template-columns:1fr;gap:1.5rem;padding-top:3.5rem;padding-bottom:3.5rem}}
</style>
