---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VORS STUDIO — ковры ручной работы',
  description = 'Ковры ручной работы для дома, бизнеса и индивидуальных проектов.'
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3efe7" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script is:inline define:vars={{ base }}>
      if (base !== '/') {
        document.querySelectorAll('a[href^="/"]').forEach((link) => {
          const href = link.getAttribute('href');
          if (!href || href.startsWith(base) || href.startsWith('//')) return;
          link.setAttribute('href', `${base}${href.replace(/^\/+/, '')}`);
        });
      }

      // Preserve the old home-screen shortcut used by the workshop app before
      // the public website took over this path. The same-origin iframe retains
      // access to the installation's existing localStorage without removing it.
      const oldHome = window.matchMedia('(display-mode: standalone)').matches ||
        window.navigator.standalone === true;
      const rootScope = new URL(base, window.location.origin).href;
      if (oldHome && window.location.href.split(/[?#]/)[0].replace(/\/+$/, '/') === rootScope) {
        const appFrame = document.createElement('iframe');
        appFrame.title = 'VORS Studio — управление мастерской';
        appFrame.src = new URL('app/?v=1.2.3', rootScope).href;
        appFrame.setAttribute('allow', 'clipboard-read; clipboard-write');
        appFrame.style.cssText =
          'position:fixed;inset:0;width:100%;height:100%;height:100dvh;z-index:2147483646;border:0;background:#f3f0e9;';
        document.body.appendChild(appFrame);
        document.documentElement.style.overflow = 'hidden';
        document.body.style.overflow = 'hidden';
      }

      // Retire only the legacy root worker; do not wipe the new /app/ cache or
      // any localStorage records (projects, materials and purchases).
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          registrations.forEach((registration) => {
            if (registration.scope === rootScope) registration.unregister();
          });
        });
      }
      if ('caches' in window) {
        const retired = new Set([
          'vors-studio-v1.1.0-flow-r2',
          'vors-studio-v1.2.1-exact-mark'
        ]);
        caches.keys().then(keys => Promise.all(
          keys.filter(key => retired.has(key)).map(key => caches.delete(key))
        ));
      }
    </script>
  </body>
</html>
